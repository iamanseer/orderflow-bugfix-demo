@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="page-header">
    <h1>Something went wrong</h1>
    <p class="page-header__subtitle">An unexpected error occurred while processing your request.</p>
</div>

<div class="card">
    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <p>
        Enable the <strong>Development</strong> environment locally (set
        <code>ASPNETCORE_ENVIRONMENT=Development</code>) to see full exception details.
        It should never be enabled on a deployed instance.
    </p>
</div>
